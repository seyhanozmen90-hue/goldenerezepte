# Supabase + Vercel için .env değerleri
# Bu değerleri Vercel dashboard > Settings > Environment Variables'a gir

# Supabase > Settings > Database > Connection string > "Transaction" (port 6543)
DATABASE_URL="postgresql://postgres.[proje-id]:[sifre]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase > Settings > Database > Connection string > "Session" (port 5432)
DIRECT_URL="postgresql://postgres.[proje-id]:[sifre]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Vercel deploy sonrası kendi domain'in
NEXTAUTH_URL="https://goldenerezepte.vercel.app"

# Rastgele uzun bir string — değiştirme
NEXTAUTH_SECRET="goldenerezepte-geheimnis-2024"
